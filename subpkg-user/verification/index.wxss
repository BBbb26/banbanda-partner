page {
  --background: #FAF5FF;
  --foreground: #1E1B2E;
  --card: #FFFFFF;
  --primary: #A855F7;
  --primary-light: #C084FC;
  --primary-dark: #9333EA;
  --primary-foreground: #FFFFFF;
  --accent: #DDD6FE;
  --border: #E9D5FF;
  --muted: #F3E8FF;
  --muted-foreground: #6B7280;
  --success: #10B981;
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 30rpx;
  --shadow-card: 0 2rpx 12rpx rgba(30, 27, 46, 0.05);
  --shadow-btn: 0 4rpx 14rpx rgba(168, 85, 247, 0.28);
}

.verify-page {
  min-height: 100vh;
  background: var(--background);
  display: flex;
  flex-direction: column;
}

/* ================================
   顶部进度条
   ================================ */
.progress-bar-wrap {
  padding: 24rpx 32rpx 20rpx;
  background: var(--card);
  border-bottom: 2rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

.progress-track {
  height: 8rpx;
  background: var(--muted);
  border-radius: 9999rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
  border-radius: 9999rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.p-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  opacity: 0.45;
  transition: opacity 0.3s ease;
}

.p-step-done,
.p-step-active {
  opacity: 1;
}

.p-step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  background: var(--muted);
  color: var(--muted-foreground);
  border: 3rpx solid var(--border);
  transition: all 0.3s ease;
}

.p-step-done .p-step-dot {
  background: var(--success);
  color: #fff;
  border-color: var(--success);
}

.p-step-active .p-step-dot {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  box-shadow: 0 4rpx 12rpx rgba(168, 85, 247, 0.3);
}

.p-step-check {
  font-size: 22rpx;
  font-weight: 700;
}

.p-step-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--foreground);
}

/* ================================
   滚动区域
   ================================ */
.verify-scroll {
  flex: 1;
  height: calc(100vh - 200rpx);
}

/* ================================
   头部品牌区
   ================================ */
.hero-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 32rpx 24rpx;
}

.hero-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.hero-icon-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  box-shadow: 0 8rpx 24rpx rgba(168, 85, 247, 0.3);
}

.hero-icon-text {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.hero-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--foreground);
  line-height: 1.3;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--muted-foreground);
  line-height: 1.4;
}

/* ================================
   权益说明卡片
   ================================ */
.benefits-card {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #F3E8FF 0%, #EDE9FE 100%);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
}

.benefits-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.benefits-icon {
  font-size: 28rpx;
}

.benefits-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-dark);
}

.benefits-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.benefit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
  margin-top: 12rpx;
}

.benefit-text {
  font-size: 26rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

/* ================================
   认证方式选择
   ================================ */
.method-section {
  padding: 0 32rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--foreground);
  margin-bottom: 20rpx;
  display: block;
}

.method-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.method-card:active {
  transform: scale(0.98);
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(168, 85, 247, 0.12);
}

.method-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.method-icon-primary {
  background: linear-gradient(135deg, #F3E8FF 0%, #DDD6FE 100%);
}

.method-icon-secondary {
  background: linear-gradient(135deg, #ECFDF5 0%, #A7F3D0 100%);
}

.method-icon-emoji {
  font-size: 36rpx;
}

.method-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.method-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--foreground);
}

.method-desc {
  font-size: 24rpx;
  color: var(--muted-foreground);
  line-height: 1.4;
}

.method-arrow {
  font-size: 36rpx;
  color: var(--muted-foreground);
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ================================
   表单区域
   ================================ */
.form-section {
  padding: 0 32rpx;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.form-header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.form-header-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--muted);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--foreground);
}

.switch-link {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  padding: 10rpx 20rpx;
  border-radius: var(--radius-md);
  transition: background 0.2s ease;
}

.switch-link:active {
  background: var(--muted);
}

/* ================================
   上传区域
   ================================ */
.upload-area {
  border: 3rpx dashed var(--primary);
  background: linear-gradient(135deg, #F3E8FF 0%, #EDE9FE 100%);
  border-radius: var(--radius-lg);
  padding: 48rpx 32rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.upload-area:active {
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%);
  transform: scale(0.99);
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(168, 85, 247, 0.3);
}

.upload-plus {
  font-size: 40rpx;
  color: var(--primary-foreground);
  font-weight: 300;
  line-height: 1;
}

.upload-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--foreground);
}

.upload-hint {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

.upload-uploaded {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-success-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--success);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.3);
}

.upload-check {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}

.upload-filename {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--success);
}

.upload-reupload {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

/* ================================
   表单提示
   ================================ */
.form-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
}

.tip-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

/* ================================
   输入字段
   ================================ */
.field-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--foreground);
}

.field-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 28rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  transition: border-color 0.2s ease;
}

.field-box:active {
  border-color: var(--primary);
}

.field-box-filled {
  border-color: var(--primary);
  background: var(--muted);
}

.field-box-text {
  font-size: 30rpx;
  color: var(--muted-foreground);
}

.field-box-filled .field-box-text {
  color: var(--foreground);
  font-weight: 600;
}

.field-box-arrow {
  font-size: 32rpx;
  color: var(--muted-foreground);
  font-weight: 300;
}

.field-input-wrap {
  height: 96rpx;
  padding: 0 28rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  transition: border-color 0.2s ease;
}

.field-input-wrap:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(168, 85, 247, 0.1);
}

.field-input {
  width: 100%;
  height: 100%;
  font-size: 30rpx;
  color: var(--foreground);
}

.field-input::placeholder {
  color: #9CA3AF;
  font-size: 28rpx;
}

/* ================================
   底部固定操作栏
   ================================ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
  background: var(--card);
  border-top: 2rpx solid var(--border);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(30, 27, 46, 0.06);
}

.bottom-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.skip-btn {
  font-size: 26rpx;
  color: var(--muted-foreground);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.skip-btn:active {
  background: rgba(0, 0, 0, 0.04);
}

.submit-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--primary-foreground);
  font-size: 28rpx;
  font-weight: 700;
  border-radius: var(--radius-md);
  border: none;
  box-shadow: var(--shadow-btn);
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
  margin: 0;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.submit-btn-disabled {
  background: var(--muted);
  color: var(--muted-foreground);
  box-shadow: none;
}

.submit-btn-disabled:active {
  transform: none;
  opacity: 1;
}

/* ================================
   底部安全间距
   ================================ */
.bottom-spacer {
  height: 160rpx;
}

/* ================================
   响应式适配
   ================================ */
@media screen and (max-height: 700px) {
  .hero-section {
    padding: 24rpx 32rpx 20rpx;
  }

  .hero-icon-wrap {
    width: 80rpx;
    height: 80rpx;
  }

  .hero-icon-text {
    width: 80rpx;
    height: 80rpx;
    font-size: 36rpx;
  }

  .hero-icon-bg {
    border-radius: 22rpx;
  }

  .hero-title {
    font-size: 32rpx;
  }

  .benefits-card {
    margin: 0 32rpx 20rpx;
    padding: 20rpx 24rpx;
  }

  .method-card {
    padding: 24rpx;
  }

  .upload-area {
    padding: 36rpx 24rpx;
  }

  .upload-icon-circle {
    width: 64rpx;
    height: 64rpx;
  }

  .upload-plus {
    font-size: 32rpx;
  }

  .bottom-spacer {
    height: 140rpx;
  }
}

@media screen and (min-height: 800px) {
  .hero-section {
    padding: 40rpx 32rpx 28rpx;
  }

  .benefits-card {
    margin: 0 32rpx 28rpx;
    padding: 28rpx 32rpx;
  }

  .method-card {
    padding: 32rpx;
  }

  .upload-area {
    padding: 56rpx 32rpx;
  }
}
