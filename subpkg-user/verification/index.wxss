.verify-page {
  min-height: 100vh;
  background: var(--background, #FAF5FF);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ================================
   头部区域
   ================================ */
.header {
  background: #fff;
  border-bottom: 2rpx solid var(--border, #E9D5FF);
  padding: 32rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #A855F7, #7C3AED);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(168, 85, 247, 0.25);
}

.header-icon::after {
  content: '🛡️';
  font-size: 40rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.header-title {
  color: var(--foreground, #1E1B2E);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.header-sub {
  color: var(--muted-foreground, #6B7280);
  font-size: 26rpx;
  line-height: 1.4;
  margin-top: 4rpx;
  display: block;
}

/* ================================
   权益说明卡片
   ================================ */
.benefits {
  margin: 28rpx 32rpx;
  background: linear-gradient(135deg, #F3E8FF 0%, #EDE9FE 100%);
  border: 3rpx dashed var(--primary, #A855F7);
  border-radius: 28rpx;
  padding: 28rpx;
}

.benefits-title {
  color: var(--primary, #7C3AED);
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.benefits-title::before {
  content: '✨';
  font-size: 28rpx;
}

.benefit-item {
  color: var(--muted-foreground, #6B7280);
  font-size: 26rpx;
  margin-top: 10rpx;
  line-height: 1.5;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.benefit-item::before {
  content: '•';
  color: var(--primary, #A855F7);
  font-weight: 800;
  font-size: 32rpx;
  line-height: 1;
  margin-top: 2rpx;
}

/* ================================
   认证方式选择
   ================================ */
.method-list,
.form-wrap {
  padding: 0 16rpx;
}

.section-label {
  color: var(--foreground, #1E1B2E);
  font-size: 28rpx;
  font-weight: 700;
  margin: 16rpx 0 20rpx;
}

.method-card {
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  padding: 32rpx;
  border: 2rpx solid var(--border, #E9D5FF);
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(168, 85, 247, 0.06);
  text-align: left;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  transition: all 0.2s ease;
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.method-card::after {
  border: none;
}

.method-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(168, 85, 247, 0.1);
  border-color: var(--primary, #A855F7);
}

.method-card-lite {
  border-color: var(--border, #E9D5FF);
  box-shadow: none;
}

.method-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
}

.method-title {
  color: var(--foreground, #1E1B2E);
  font-size: 32rpx;
  font-weight: 800;
  text-align: left;
}

.method-desc {
  color: var(--muted-foreground, #6B7280);
  font-size: 26rpx;
  line-height: 1.4;
  display: block;
  text-align: left;
}

/* ================================
   表单区域
   ================================ */
.form-head {
  margin: 16rpx 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-title {
  color: var(--foreground, #1E1B2E);
  font-size: 34rpx;
  font-weight: 800;
}

.switch-link {
  color: var(--primary, #7C3AED);
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: background 0.2s ease;
}

.switch-link:active {
  background: var(--primary-50, #F3E8FF);
}

/* 上传区域 */
.upload-box {
  border: 3rpx dashed var(--primary, #A855F7);
  background: linear-gradient(135deg, #F3E8FF 0%, #EDE9FE 100%);
  border-radius: 28rpx;
  padding: 56rpx 32rpx;
  text-align: center;
  margin-bottom: 28rpx;
  transition: all 0.2s ease;
}

.upload-box:active {
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 100%);
  transform: scale(0.99);
}

.upload-title {
  color: var(--foreground, #1E1B2E);
  font-size: 30rpx;
  font-weight: 700;
}

.ok-text {
  color: var(--success, #10B981);
  font-size: 30rpx;
  font-weight: 700;
}

.tip-text {
  color: var(--muted-foreground, #6B7280);
  font-size: 26rpx;
  margin-top: 12rpx;
  display: block;
}

/* 输入字段 */
.field {
  margin-bottom: 24rpx;
}

.field-label {
  color: var(--foreground, #1E1B2E);
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: block;
}

.field-box,
.field-input {
  border: 2rpx solid var(--border, #E9D5FF);
  border-radius: 20rpx;
  background: #fff;
  height: 96rpx;
  padding: 0 28rpx;
  color: var(--foreground, #1E1B2E);
  font-size: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.field-input {
  width: 100%;
}

.field-box {
  color: var(--muted-foreground, #6B7280);
}

.field-input::placeholder {
  color: #9CA3AF;
  font-size: 28rpx;
}

/* ================================
   提交按钮（核心修复）
   ================================ */
.submit-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(135deg, #7C3AED 0%, #9333EA 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);

  /* 关键：确保文字完美居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(124, 58, 237, 0.25);
}

/* ================================
   底部区域
   ================================ */
.footer {
  margin-top: 40rpx;
  text-align: center;
  padding-bottom: 40rpx;
}

.skip-text {
  color: var(--muted-foreground, #6B7280);
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  transition: background 0.2s ease;
}

.skip-text:active {
  background: rgba(0, 0, 0, 0.04);
}

/* ================================
   响应式适配
   ================================ */
@media screen and (max-height: 700px) {
  .header {
    padding: 24rpx;
  }

  .header-icon {
    width: 64rpx;
    height: 64rpx;
    border-radius: 20rpx;
  }

  .header-title {
    font-size: 32rpx;
  }

  .benefits {
    margin: 20rpx 24rpx;
    padding: 20rpx;
  }

  .method-list,
  .form-wrap {
    padding: 0 24rpx;
  }

  .method-card {
    padding: 24rpx;
    margin-bottom: 16rpx;
  }

  .upload-box {
    padding: 40rpx 24rpx;
  }

  .submit-btn {
    height: 88rpx;
    font-size: 30rpx;
  }
}
