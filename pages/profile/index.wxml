<view class="profile-page">
  <!-- ==================== 未登录状态：全新登录/注册页 ==================== -->
  <block wx:if="{{!isAuthenticated}}">
    <!-- 背景装饰 -->
    <view class="auth-bg">
      <view class="auth-blob blob-1"></view>
      <view class="auth-blob blob-2"></view>
      <view class="auth-blob blob-3"></view>
    </view>

    <!-- 主内容区 -->
    <view class="auth-container">
      <!-- 顶部品牌区 -->
      <view class="auth-brand">
        <view class="brand-logo">
          <text class="brand-emoji">🎓</text>
        </view>
        <text class="brand-title">校园搭子</text>
        <text class="brand-slogan">找到志同道合的校园伙伴</text>
      </view>

      <!-- 登录/注册卡片 -->
      <view class="auth-card">
        <!-- 标签切换 -->
        <view class="auth-tabs">
          <view class="auth-tab {{authMode==='login'?'tab-active':''}}" bindtap="switchAuthMode" data-mode="login">
            <text class="tab-text">登录</text>
            <view class="tab-indicator" wx:if="{{authMode==='login'}}"></view>
          </view>
          <view class="auth-tab {{authMode==='register'?'tab-active':''}}" bindtap="switchAuthMode" data-mode="register">
            <text class="tab-text">注册</text>
            <view class="tab-indicator" wx:if="{{authMode==='register'}}"></view>
          </view>
        </view>

        <!-- 登录表单 -->
        <view class="auth-form" wx:if="{{authMode==='login'}}">
          <view class="form-group">
            <text class="form-label">手机号</text>
            <view class="input-wrap">
              <text class="input-icon">📱</text>
              <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{loginPhone}}" bindinput="onLoginPhoneInput" />
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">验证码</text>
            <view class="input-wrap">
              <text class="input-icon">🔐</text>
              <input class="form-input" type="number" placeholder="请输入验证码" maxlength="6" value="{{loginCode}}" bindinput="onLoginCodeInput" />
              <view class="code-btn {{countdown>0?'code-disabled':''}}" bindtap="sendLoginCode">
                <text class="code-text">{{countdown>0?countdown+'s后重发':'获取验证码'}}</text>
              </view>
            </view>
          </view>

          <button class="auth-submit-btn {{isLoginValid?'btn-active':''}}" bindtap="handleLogin">
            <text class="submit-text">立即登录</text>
          </button>
        </view>

        <!-- 注册表单 -->
        <view class="auth-form" wx:if="{{authMode==='register'}}">
          <view class="form-group">
            <text class="form-label">手机号</text>
            <view class="input-wrap">
              <text class="input-icon">📱</text>
              <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" value="{{regPhone}}" bindinput="onRegPhoneInput" />
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">验证码</text>
            <view class="input-wrap">
              <text class="input-icon">🔐</text>
              <input class="form-input" type="number" placeholder="请输入验证码" maxlength="6" value="{{regCode}}" bindinput="onRegCodeInput" />
              <view class="code-btn {{countdown>0?'code-disabled':''}}" bindtap="sendRegCode">
                <text class="code-text">{{countdown>0?countdown+'s后重发':'获取验证码'}}</text>
              </view>
            </view>
          </view>

          <view class="form-group">
            <text class="form-label">昵称</text>
            <view class="input-wrap">
              <text class="input-icon">👤</text>
              <input class="form-input" type="text" placeholder="给自己起个好听的昵称" maxlength="12" value="{{regNickname}}" bindinput="onRegNicknameInput" />
            </view>
          </view>

          <button class="auth-submit-btn {{isRegValid?'btn-active':''}}" bindtap="handleRegister">
            <text class="submit-text">立即注册</text>
          </button>
        </view>
      </view>

      <!-- 微信快捷登录 -->
      <view class="wechat-section">
        <view class="divider">
          <view class="divider-line"></view>
          <text class="divider-text">或</text>
          <view class="divider-line"></view>
        </view>

        <button class="wechat-btn" bindtap="handleWechatLogin">
          <view class="wechat-icon-wrap">
            <text class="wechat-icon">💬</text>
          </view>
          <text class="wechat-text">微信一键登录</text>
        </button>
      </view>

      <!-- 协议说明 -->
      <view class="agreement-section">
        <view class="agreement-row" bindtap="toggleAgreement">
          <view class="agreement-check {{agreed?'check-active':''}}">
            <text class="check-icon" wx:if="{{agreed}}">✓</text>
          </view>
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link" catchtap="openUserAgreement">《用户协议》</text>
          <text class="agreement-text">和</text>
          <text class="agreement-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
        </view>
      </view>

      <!-- 功能亮点 -->
      <view class="features-section">
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">🔒</text>
          </view>
          <text class="feature-text">安全认证</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">🎯</text>
          </view>
          <text class="feature-text">智能匹配</text>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon">💬</text>
          </view>
          <text class="feature-text">即时通讯</text>
        </view>
      </view>

      <!-- 底部安全间距 -->
      <view class="auth-bottom-spacer"></view>
    </view>
  </block>

  <!-- ==================== 已登录状态：显示完整用户资料 ==================== -->
  <block wx:if="{{isAuthenticated}}">
    <!-- ====== 头部 Hero 区域：左右布局 ====== -->
    <view class="hero">
      <view class="hero-main">
        <!-- 左侧：头像 + 认证徽章 -->
        <view class="hero-left">
          <view class="avatar-box">
            <text class="avatar-emoji">{{userProfile.avatarEmoji}}</text>
          </view>
          <view class="verify-badge" wx:if="{{userProfile.isVerified}}">
            <text class="verify-icon">✓</text>
          </view>
        </view>

        <!-- 右侧：信息区 -->
        <view class="hero-right">
          <view class="top-row">
            <text class="name">{{userProfile.name}}</text>
            <view wx:if="{{userProfile.isVerified}}" class="verified-tag">已认证</view>
            <view class="edit-btn" bindtap="onEditProfile">
              <text class="edit-icon">⚙</text>
            </view>
          </view>
          <text class="school-info">{{userProfile.school}} · {{userProfile.grade}}</text>
          <view class="score-row">
            <text class="star-icon">★★★★☆</text>
            <text class="score-num">{{userProfile.reliabilityScore}}</text>
          </view>
        </view>
      </view>

      <!-- 统计卡片行 -->
      <view class="stats-row">
        <view class="stat-card">
          <text class="stat-icon">🏆</text>
          <view class="stat-val">{{userProfile.completedActivities}}</view>
          <text class="stat-label">完成活动</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🤝</text>
          <view class="stat-val">{{userProfile.activePartners}}</view>
          <text class="stat-label">活跃搭子</text>
        </view>
        <view class="stat-card {{userProfile.currentPoints > 0 ? 'stat-tappable' : ''}}" bindtap="toPointsMall">
          <text class="stat-icon">⭐</text>
          <view class="stat-val">{{userProfile.currentPoints}}</view>
          <text class="stat-label">我的积分</text>
        </view>
      </view>
    </view>

    <!-- VIP 卡片 -->
    <view wx:if="{{!userProfile.isVIP}}" class="vip-card" bindtap="toVIP">
      <view class="vip-header">
        <text class="vip-title">解锁 VIP 专属权益</text>
        <text class="vip-badge-tag">限时优惠</text>
      </view>
      <text class="vip-sub">更多匹配 · 无广告 · 双倍积分</text>
      <view class="vip-btn">立即升级</view>
    </view>

    <!-- 菜单功能列表 -->
    <view class="menu-section">
      <view
        wx:for="{{menuItems}}"
        wx:key="label"
        class="menu-item"
        data-path="{{item.path}}"
        bindtap="onMenuTap"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-label">{{item.label}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 安全与认证区域 -->
    <view class="security-section">
      <!-- 实名认证 -->
      <view class="sec-item sec-auth" bindtap="onAuthVerify">
        <view class="sec-left">
          <view class="sec-icon-wrap sec-blue">
            <text class="sec-icon">🛡</text>
          </view>
          <view class="sec-body">
            <text class="sec-title">实名认证</text>
            <text class="sec-desc">提升账号可信度，获得更多推荐</text>
          </view>
        </view>
        <view wx:if="{{userProfile.isRealNameAuth}}" class="auth-status verified-status">已认证</view>
        <text wx:else class="arrow">›</text>
      </view>

      <!-- 紧急联系人设置 -->
      <view class="sec-item sec-emergency" bindtap="onEmergencyContact">
        <view class="sec-left">
          <view class="sec-icon-wrap sec-yellow">
            <text class="sec-icon">SOS</text>
          </view>
          <view class="sec-body">
            <text class="sec-title">紧急联系人设置</text>
            <text class="sec-desc">{{emergencyContact || '添加紧急联系人，保障出行安全'}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <button class="logout-btn" bindtap="handleLogout">退出登录</button>
    </view>
  </block>

  <!-- 底部安全间距 -->
  <view class="bottom-spacer"></view>
</view>
