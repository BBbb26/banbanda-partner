.profile-page {
  min-height: 100vh;
  position: relative;
  background: var(--background, #FAF5FF);
}

/* ================================
   未登录状态：全新登录/注册页
   ================================ */

/* 背景装饰 */
.auth-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #EDE9FE 0%, #DDD6FE 40%, #C4B5FD 100%);
}

.auth-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.45;
}

.blob-1 {
  width: 600rpx;
  height: 600rpx;
  background: #A78BFA;
  top: -200rpx;
  right: -150rpx;
  animation: blobFloat 8s ease-in-out infinite;
}

.blob-2 {
  width: 500rpx;
  height: 500rpx;
  background: #C4B5FD;
  bottom: 100rpx;
  left: -180rpx;
  animation: blobFloat 10s ease-in-out infinite 2s;
}

.blob-3 {
  width: 400rpx;
  height: 400rpx;
  background: #8B5CF6;
  top: 40%;
  right: -100rpx;
  animation: blobFloat 12s ease-in-out infinite 4s;
}

@keyframes blobFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(-30rpx, 30rpx) scale(1.05); }
  66% { transform: translate(20rpx, -20rpx) scale(0.95); }
}

/* 主内容区 */
.auth-container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx 140rpx;
  box-sizing: border-box;
}

/* 顶部品牌区 */
.auth-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
  margin-bottom: 48rpx;
  animation: fadeInDown 0.6s ease-out;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.brand-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.brand-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #5B21B6;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(91, 33, 182, 0.7);
  font-weight: 400;
}

/* 登录/注册卡片 */
.auth-card {
  background: rgba(255,255,255,0.95);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.12);
  animation: fadeInUp 0.6s ease-out 0.15s both;
  backdrop-filter: blur(20rpx);
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 标签切换 */
.auth-tabs {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 36rpx;
  position: relative;
}

.auth-tab {
  position: relative;
  padding: 12rpx 8rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.tab-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #9CA3AF;
  transition: color 0.3s ease;
}

.tab-active .tab-text {
  color: #7C3AED;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #7C3AED, #A855F7);
  border-radius: 4rpx;
  animation: indicatorIn 0.3s ease;
}

@keyframes indicatorIn {
  from { width: 0; opacity: 0; }
  to { width: 40rpx; opacity: 1; }
}

/* 表单 */
.auth-form {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-of-type {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 96rpx;
  transition: all 0.2s ease;
}

.input-wrap:focus-within {
  border-color: #A78BFA;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(167,139,250,0.15);
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1F2937;
  background: transparent;
  border: none;
  outline: none;
  min-width: 0;
}

.form-input::placeholder {
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 验证码按钮 */
.code-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #7C3AED, #A855F7);
  border-radius: 12rpx;
  margin-left: 12rpx;
  transition: all 0.2s ease;
}

.code-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.code-disabled {
  background: #E5E7EB;
  pointer-events: none;
}

.code-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}

.code-disabled .code-text {
  color: #9CA3AF;
}

/* 提交按钮 */
.auth-submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E5E7EB;
  border-radius: 20rpx;
  border: none;
  transition: all 0.3s ease;
  margin: 0;
  padding: 0;
}

.auth-submit-btn::after {
  display: none;
}

.btn-active {
  background: linear-gradient(135deg, #7C3AED 0%, #9333EA 100%);
  box-shadow: 0 8rpx 24rpx rgba(124,58,237,0.35);
}

.btn-active:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(124,58,237,0.25);
}

.submit-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* 微信快捷登录 */
.wechat-section {
  margin-bottom: 32rpx;
  animation: fadeInUp 0.6s ease-out 0.3s both;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(91, 33, 182, 0.2);
}

.divider-text {
  font-size: 24rpx;
  color: rgba(91, 33, 182, 0.5);
  padding: 0 24rpx;
  font-weight: 500;
}

.wechat-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 6, 0.3);
  transition: all 0.2s ease;
  margin: 0;
  padding: 0;
}

.wechat-btn::after {
  display: none;
}

.wechat-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(217, 119, 6, 0.25);
}

.wechat-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  font-size: 26rpx;
}

.wechat-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

/* 协议说明 */
.agreement-section {
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s ease-out 0.45s both;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.agreement-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(91, 33, 182, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.check-active {
  background: #07C160;
  border-color: #07C160;
}

.check-icon {
  font-size: 20rpx;
  color: #fff;
  font-weight: 800;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(91, 33, 182, 0.6);
}

.agreement-link {
  font-size: 22rpx;
  color: rgba(91, 33, 182, 0.9);
  font-weight: 600;
  text-decoration: underline;
}

/* 功能亮点 */
.features-section {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: auto;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
  animation: fadeInUp 0.6s ease-out 0.6s both;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(91, 33, 182, 0.08);
  backdrop-filter: blur(8rpx);
  border: 2rpx solid rgba(91, 33, 182, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-text {
  font-size: 22rpx;
  color: rgba(91, 33, 182, 0.65);
  font-weight: 500;
}

/* 底部安全间距 */
.auth-bottom-spacer {
  height: 100rpx;
  flex-shrink: 0;
}

/* ================================
   已登录状态 UI（保持原有设计）
   ================================ */

.hero {
  margin: 0;
  padding: 36rpx 24rpx 28rpx;
  background: linear-gradient(135deg, #7C3AED 0%, #9333EA 50%, #A855F7 100%);
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.hero-main {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.hero-left {
  position: relative;
  flex-shrink: 0;
}

.avatar-box {
  width: 130rpx;
  height: 130rpx;
  border-radius: 26rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.avatar-emoji { font-size: 64rpx; line-height: 1; }

.verify-badge {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--success, #f8dc86ff);
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(16,185,129,0.35);
}

.verify-icon {
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-top: 4rpx;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.verified-tag {
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 3px 12rpx;
  border-radius: 8rpx;
}

.edit-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  flex-shrink: 0;
}

.edit-icon { font-size: 30rpx; color: rgba(255,255,255,0.85); }

.school-info {
  font-size: 25rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 8rpx;
  display: block;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.star-icon { font-size: 26rpx; color: #FBBF24; line-height: 1; }
.score-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #FBBF24;
  line-height: 1;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: rgba(255,255,255,0.18);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  backdrop-filter: blur(8rpx);
}

.stat-tappable { cursor: pointer; }
.stat-tappable:active { opacity: 0.85; transform: scale(0.97); transition: all 0.15s; }

.stat-icon { font-size: 36rpx; margin-bottom: 6rpx; }
.stat-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}
.stat-label {
  font-size: 21rpx;
  color: rgba(255,255,255,0.78);
  margin-top: 4rpx;
}

/* VIP 卡片 */
.vip-card {
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border: 2rpx solid #FCD34D;
  padding: 24rpx;
}

.vip-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.vip-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #92400E;
}

.vip-badge-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #DC2626;
  background: #FEE2E2;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.vip-sub {
  display: block;
  color: #B45309;
  font-size: 23rpx;
  margin-top: 6rpx;
  margin-bottom: 14rpx;
}

.vip-btn {
  display: inline-block;
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 32rpx;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(217,119,6,0.3);
}

.vip-card:active .vip-btn { opacity: 0.9; transform: scale(0.97); }

/* 菜单功能列表 */
.menu-section {
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid var(--border, #E9D5FF);
}

.menu-item {
  padding: 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border-light, #F3E8FF);
}
.menu-item:last-child { border-bottom: none; }

.menu-icon { font-size: 32rpx; width: 48rpx; flex-shrink: 0; text-align: center; }
.menu-label {
  margin-left: 16rpx;
  flex: 1;
  color: var(--foreground, #1E1B2E);
  font-size: 28rpx;
  font-weight: 600;
}
.arrow {
  color: var(--muted-foreground, #6B7280);
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 安全与认证区域 */
.security-section {
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid var(--border, #E9D5FF);
}

.sec-item {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid var(--border-light, #F3E8FF);
}
.sec-item:last-child { border-bottom: none; }

.sec-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.sec-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sec-blue { background: #EFF6FF; }
.sec-yellow { background: #FEFCE8; }

.sec-icon { font-size: 32rpx; }
.sec-yellow .sec-icon {
  font-size: 20rpx;
  font-weight: 900;
  color: #D97706;
  letter-spacing: -1rpx;
}

.sec-body { min-width: 0; }

.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--foreground, #1E1B2E);
  display: block;
}

.sec-desc {
  font-size: 22rpx;
  color: var(--muted-foreground, #6B7280);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-status {
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}

.verified-status {
  background: #ECFDF5;
  color: var(--success, #10B981);
  border: 2rpx solid #A7F3D0;
}

/* 退出登录 */
.logout-section {
  margin: 20rpx 24rpx 0;
  padding: 0 0 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #EF4444;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #FECACA;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.logout-btn::after {
  display: none;
}

.logout-btn:active {
  background: #FEF2F2;
  transform: scale(0.98);
}

/* 底部安全间距 */
.bottom-spacer { height: 40rpx; }

/* ================================
   响应式适配
   ================================ */

/* 小屏手机适配 */
@media screen and (max-height: 700px) {
  .auth-brand {
    padding-top: 60rpx;
    margin-bottom: 32rpx;
  }
  .brand-logo {
    width: 120rpx;
    height: 120rpx;
  }
  .brand-title {
    font-size: 42rpx;
  }
  .auth-card {
    padding: 32rpx 28rpx;
  }
  .features-section {
    gap: 36rpx;
    padding-top: 24rpx;
    padding-bottom: 24rpx;
  }
}

/* 大屏手机/平板适配 */
@media screen and (min-height: 850px) {
  .auth-brand {
    padding-top: 140rpx;
  }
  .auth-card {
    padding: 48rpx 40rpx;
  }
}

/* 超小屏适配 */
@media screen and (max-height: 600px) {
  .auth-brand {
    padding-top: 40rpx;
    margin-bottom: 24rpx;
  }
  .brand-logo {
    width: 100rpx;
    height: 100rpx;
    margin-bottom: 16rpx;
  }
  .brand-emoji {
    font-size: 56rpx;
  }
  .auth-card {
    padding: 28rpx 24rpx;
    margin-bottom: 20rpx;
  }
  .form-group {
    margin-bottom: 20rpx;
  }
  .input-wrap {
    height: 84rpx;
  }
  .auth-submit-btn {
    height: 88rpx;
  }
  .features-section {
    display: none;
  }
  .auth-bottom-spacer {
    height: 60rpx;
  }
}
